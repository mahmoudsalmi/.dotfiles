# Repository files: tracked by Git, never deployed into HOME.
bootstrap.sh
install.sh
README.md
docs

# Host-specific overrides and saved session state.
.config/zsh/local.zsh
.config/tmux/resurrect
.config/tmux/resurrect/**
.config/tmux/sessions
.config/tmux/sessions/**
.gitconfig.local
.config/mise/config.local.toml
.config/mise/config.*.local.toml

{{- if not .terminals }}

# Terminal emulator configs, installed only when chosen during chezmoi init.
.config/alacritty
.config/ghostty
.config/kitty
.config/wezterm
{{- end }}

{{- if ne .chezmoi.os "darwin" }}

# macOS launchd service definitions, only used by `mise run services:macos`.
.config/mise/macos-services
{{- end }}
