[user]  
  email = mahmoud@salmi.dev
  name = Mahmoud SALMI

[init]
  defaultbranch = main

[core]
  autocrlf = input
  excludesfile = ~/.gitignore_global

[pull]
  rebase = true

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[lfs "ssh"]
  automultiplex = false

[alias]
  # basic
  co = checkout
  ci = commit
  # config
  conf = config --global --edit
  # logs
  lol = log --oneline --decorate --all
  graph = log --graph --oneline --decorate --all
  # diff
  d = diff --word-diff
  # status
  s = status -sb
  st = status -b

[Grep]
  lineNumber = true
  extendedRegexp = true

[color]
  ui = auto

[color.decorate]
  HEAD         = 6
  branch       = 2 bold
  remoteBranch = 1
  tag          = 5 bold
  stash        = 3 dim

[color "diff"]
  meta       = 8
  frag       = 4 bold
  old        = 1
  new        = 2

[color "status"]
  added      = 2 bold
  changed    = 3
  untracked  = 11
  ignored    = 0

[color "branch"]
  current    = 1 reverse
  local      = 5
  remote     = 8

[merge] 
  conflictstyle = diff3
  tool = nvimdiff

[mergetool "nvimdiff"]
  cmd = nvim -d "$LOCAL" "$BASE" "$REMOTE" "$MERGED" -c '4wincmd w'
  trustExitCode = false

[diff]
  tool = nvimdiff

[difftool "nvimdiff"]
  cmd = nvim -d "$LOCAL" "$REMOTE"
  trustExitCode = true

[include]
  path = ~/.gitconfig.local


